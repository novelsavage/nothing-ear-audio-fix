#!/usr/bin/env bash
set -euo pipefail
# Keep local desktop audio separate from Chrome Remote Desktop audio.
config_root="${XDG_CONFIG_HOME:-$HOME/.config}"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/nothing-ear-audio-fix"
local_socket="unix:/run/user/$(id -u)/pulse/native"
device_address="${NOTHING_EAR_ADDRESS:-}"
if [[ -z "$device_address" && -f "$state_root/device-address" ]]; then
  device_address="$(cat "$state_root/device-address")"
fi
mode="${1:-apply}"
if [[ "$mode" != check ]]; then
  [[ "$device_address" =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]] || {
    echo 'NOTHING_EAR_ADDRESS に対象機器のBluetoothアドレスを指定してください。' >&2
    exit 2
  }
fi
device_address="${device_address^^}"
sink="bluez_output.$device_address"
card="bluez_card.${device_address//:/_}"
files=(
  'systemd/user/wireplumber.service.d/10-local-audio.conf'
  'systemd/user/plasma-plasmashell.service.d/10-local-audio.conf'
  'wireplumber/wireplumber.conf.d/51-nothing-ear-volume.conf'
)
check() {
  systemctl --user is-active wireplumber.service plasma-plasmashell.service || true
  systemctl --user show wireplumber.service plasma-plasmashell.service -p Environment
  printf '現在の標準出力: '
  PULSE_SERVER="$local_socket" pactl get-default-sink
  PULSE_SERVER="$local_socket" pactl get-sink-volume @DEFAULT_SINK@
}
restart_audio() {
  systemctl --user daemon-reload
  systemctl --user restart wireplumber.service
  for ((attempt=0; attempt<30; attempt++)); do
    if PULSE_SERVER="$local_socket" pactl list short sinks | awk '{print $2}' | grep -Fxq "$sink"; then
      PULSE_SERVER="$local_socket" pactl set-default-sink "$sink"
      break
    fi
    sleep 0.5
  done
  systemctl --user restart plasma-plasmashell.service
}
case "$mode" in
  check) check; exit ;;
  restart) restart_audio; check; exit ;;
  auto-connect)
    mkdir -p "$state_root"
    exec 9> "$state_root/auto-connect.lock"
    flock -n 9 || exit 0
    # A failed query is not evidence of disconnection.
    sinks="$(PULSE_SERVER="$local_socket" pactl list short sinks)" || exit 1
    if awk '{print $2}' <<< "$sinks" | grep -Fxq "$sink"; then
      if [[ ! -f "$state_root/connected" ]]; then
        bash "${BASH_SOURCE[0]}" apply
        PULSE_SERVER="$local_socket" pactl set-default-sink "$sink"
        touch "$state_root/connected"
        echo 'Nothing Earの接続を検知し、設定確認と標準出力の切り替えを実行しました。'
      fi
    else
      rm -f "$state_root/connected"
    fi
    exit ;;
  enable-auto)
    unit_dir="$config_root/systemd/user"
    mkdir -p "$unit_dir"
    cat > "$unit_dir/nothing-ear-audio-fix.service" <<'UNIT'
[Unit]
Description=Check Nothing Ear connection and recover local audio configuration
[Service]
Type=oneshot
ExecStart=%h/.local/bin/nothing-ear-audio-fix auto-connect
UNIT
    cat > "$unit_dir/nothing-ear-audio-fix.timer" <<'UNIT'
[Unit]
Description=Detect Nothing Ear audio connection every five seconds
[Timer]
OnStartupSec=5s
OnUnitInactiveSec=5s
AccuracySec=1s
[Install]
WantedBy=timers.target
UNIT
    rm -f "$state_root/connected"
    systemctl --user daemon-reload
    systemctl --user enable --now nothing-ear-audio-fix.timer
    echo 'ログイン中、約5秒間隔で接続を確認します。'
    exit ;;
  disable-auto)
    systemctl --user disable --now nothing-ear-audio-fix.timer
    systemctl --user stop nothing-ear-audio-fix.service
    rm -f "$state_root/connected"
    echo '接続時の自動実行を停止しました。'
    exit ;;
  undo)
    if [[ -f "$config_root/systemd/user/nothing-ear-audio-fix.timer" ]]; then
      systemctl --user disable --now nothing-ear-audio-fix.timer
      systemctl --user stop nothing-ear-audio-fix.service
    fi
    [[ -f "$state_root/installed" ]] || { echo '復元用バックアップがありません。'; exit 1; }
    for relative in "${files[@]}"; do
      if [[ -f "$state_root/backup/$relative" ]]; then
        mkdir -p "$(dirname "$config_root/$relative")"
        cp -p "$state_root/backup/$relative" "$config_root/$relative"
      else
        rm -f "$config_root/$relative"
      fi
    done
    restart_audio
    rm -f "$state_root/installed"
    rm -rf "$state_root/backup"
    echo '初回適用直前の設定へ復元しました。'
    exit ;;
  apply) ;;
  *) echo '使い方: nothing-ear-audio-fix [apply|check|restart|undo|enable-auto|disable-auto|auto-connect]'; exit 2 ;;
esac
mkdir -p "$state_root"
printf '%s\n' "$device_address" > "$state_root/device-address"
if [[ ! -f "$state_root/installed" ]]; then
  for relative in "${files[@]}"; do
    if [[ -e "$config_root/$relative" ]]; then
      mkdir -p "$(dirname "$state_root/backup/$relative")"
      cp -p "$config_root/$relative" "$state_root/backup/$relative"
    fi
  done
  touch "$state_root/installed"
fi
work_dir="$(mktemp -d)"
trap 'rm -rf "$work_dir"' EXIT
cat > "$work_dir/0" <<'CONF'
[Service]
Environment=PIPEWIRE_REMOTE=pipewire-0
UnsetEnvironment=PULSE_RUNTIME_PATH PULSE_SINK PULSE_SERVER
CONF
cat > "$work_dir/1" <<CONF
[Service]
Environment=PIPEWIRE_REMOTE=pipewire-0
Environment=PULSE_SERVER=$local_socket
UnsetEnvironment=PULSE_RUNTIME_PATH PULSE_SINK
CONF
cat > "$work_dir/2" <<CONF
# Use software volume for Nothing Ear to avoid Bluetooth volume feedback.
monitor.bluez.rules = [
  {
    matches = [ { device.name = "$card" } ]
    actions = {
      update-props = {
        bluez5.hw-volume = [ ]
      }
    }
  }
]
CONF
changed=0
for index in "${!files[@]}"; do
  target="$config_root/${files[$index]}"
  if ! cmp -s "$work_dir/$index" "$target"; then
    mkdir -p "$(dirname "$target")"
    cp "$work_dir/$index" "$target"
    changed=1
  fi
done
if ((changed)); then
  restart_audio
  echo '設定を適用して音声管理とパネルを再起動しました。'
else
  echo '設定は適用済みです。再起動は省略しました。'
fi
check
